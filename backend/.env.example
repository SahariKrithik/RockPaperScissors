# Backend production environment
# Fill in the value, then paste this into Render:
# your service > Environment > "Add from .env" and paste the contents.
#
# Get the connection string from MongoDB Atlas: Connect > Drivers.
# Replace user and password with the database user you created.
# NEVER commit the filled-in version of this file.

MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/

# PORT is not needed: Render sets it automatically and the server reads it.
